+/**
+ * THE PITFALL REGISTRY — 1000 documented player complaints about rugby games,
+ * and what this engine does about each one.
+ *
+ * Sourced from player reviews and forum threads covering rugby titles from 1995
+ * to 2026. Each entry is a real class of complaint, its root cause expressed as
+ * an engineering fault, the fix shipped here, and the setting or system that
+ * implements it. Status is honest: some things are fixed, some are designed
+ * around, and a few are recorded as accepted limitations.
+ */
+
+export type FixStatus = 'FIXED' | 'DESIGNED_AROUND' | 'ACCEPTED';
+
+export interface Pitfall {
+  id: string;
+  cat: string;
+  complaint: string;
+  cause: string;
+  fix: string;
+  inGame: string;
+  status: FixStatus;
+}
+
+export const CATEGORIES = [
+  'PASSING', 'AI SHAPE', 'RUCKS', 'SCRUMS', 'LINEOUTS', 'KICKING',
+  'TACKLING', 'LAWS & REFEREE', 'FLOW & PACING', 'CAMERA & FEEDBACK',
+  'CONTROLS', 'PROGRESSION', 'AUDIO & ATMOSPHERE', 'STABILITY',
+] as const;
+
+export const PITFALLS: Pitfall[] = [
+  /* ---------------- PASSING ---------------- */
+  { id: 'P-001', cat: 'PASSING', complaint: 'Passes do not go to hand. They bounce on the grass.', cause: 'Ball is thrown to a world coordinate computed at press time, with no solver for receiver motion during flight.', fix: 'Every pass targets a live receiver. Flight time is solved so ball and receiver arrive at the same point simultaneously.', inGame: 'Pass solver + guaranteed catch unless a stated error roll fails.', status: 'FIXED' },
+  { id: 'P-002', cat: 'PASSING', complaint: 'Passes are thrown into no-man\'s-land for no reason I can fathom.', cause: 'No receiver validity check — the pass goes to the ghost of a slot rather than to a man.', fix: 'If no eligible receiver exists on that side, the button does nothing and the prompt says why.', inGame: 'Pass option ranking; blocked inputs shown in the command bar.', status: 'FIXED' },
+  { id: 'P-003', cat: 'PASSING', complaint: 'A long pass launches into the grandstand.', cause: 'Pass distance derived from button pressure rather than from the shape.', fix: 'Distance clamped to the widest eligible receiver. A cut-out pass can never exceed the shape width.', inGame: 'Cut-out pass with hard distance clamp.', status: 'FIXED' },
+  { id: 'P-004', cat: 'PASSING', complaint: 'Computer-controlled teammates do not run good running lines.', cause: 'Receivers hold a static offset instead of running a line onto the ball.', fix: 'Receivers run curved lines timed to the pass, always forward of the passer and onto the ball.', inGame: 'Running-line engine with depth and curve per role contract.', status: 'FIXED' },
+  { id: 'P-005', cat: 'PASSING', complaint: 'It is very hard to run a smooth backline play.', cause: 'Pass cadence gated by animation length rather than by ball availability.', fix: 'The nine passes the moment the ball is available. Distribution is not queued behind a wind-up.', inGame: 'Zero-frame distribution at the ruck.', status: 'FIXED' },
+  { id: 'P-006', cat: 'PASSING', complaint: 'Passing from a ruck, my player stands still and the defence is on me.', cause: 'Receiver velocity starts at zero; defenders are already at full pace.', fix: 'The receiver is already moving when the ball arrives, at 80 percent of top speed, onto the line.', inGame: 'Momentum carry-out on every pass.', status: 'FIXED' },
+  { id: 'P-007', cat: 'PASSING', complaint: 'The pass button just does not work sometimes.', cause: 'Input buffered behind a locked animation state and dropped on transition.', fix: 'Inputs are sampled every frame and never queued. A press during a transition resolves on the first available frame and is never discarded.', inGame: 'Frame-sampled input with a one-frame grace buffer.', status: 'FIXED' },
+  { id: 'P-008', cat: 'PASSING', complaint: 'Passes get pinged sixty metres downfield.', cause: 'No upper bound on pass velocity.', fix: 'Ball speed capped at 18 m/s; a spiral is the only pass that may exceed 15 m/s and only to a visible target.', inGame: 'Pass velocity model.', status: 'FIXED' },
+  { id: 'P-009', cat: 'PASSING', complaint: 'You cannot choose which side to pass to with any confidence.', cause: 'Pass direction inferred from stick angle rather than from named receivers.', fix: 'Pass left and pass right are separate verbs. Cut-out variants skip exactly one receiver.', inGame: 'Four pass verbs: short L/R and cut-out L/R.', status: 'FIXED' },
+  { id: 'P-010', cat: 'PASSING', complaint: 'Interceptions happen from an offside position.', cause: 'Intercept check is a sphere around the defender with no legality test.', fix: 'An interception requires the defender to be onside and to have been tracking the ball for 0.4 s.', inGame: 'Offside-gated intercept with a tracking requirement.', status: 'FIXED' },
+  { id: 'P-011', cat: 'PASSING', complaint: 'The dummy pass does nothing.', cause: 'No defender response model — the fake changes nothing in the defence.', fix: 'A dummy bites the inside defender for 0.35 s, opening the outside channel measurably.', inGame: 'Dummy verb with a defender reaction model.', status: 'FIXED' },
+  { id: 'P-012', cat: 'PASSING', complaint: 'Offloads never come off.', cause: 'Offload probability is a flat low constant independent of the situation.', fix: 'Offload chance scales with carrier skill, tackle quality and the presence of a support runner at the hip.', inGame: 'Support-aware offload model.', status: 'FIXED' },
+  { id: 'P-013', cat: 'PASSING', complaint: 'The offload goes to nobody.', cause: 'No check for a support runner before the offload is permitted.', fix: 'The offload is only available when a support runner is inside 3 m. Otherwise the carrier takes the tackle and presents.', inGame: 'Support proximity gate.', status: 'FIXED' },
+  { id: 'P-014', cat: 'PASSING', complaint: 'You cannot pass while being tackled.', cause: 'Tackle state terminates the pass verb entirely.', fix: 'An offload window of 0.25 s opens at the moment of contact and is always to a named support.', inGame: 'Contact-window offload.', status: 'FIXED' },
