+      cx = clamp(car.x, -33, 33); cz = clamp(car.z, -58, 58);
+    }
+    car.vx = 0;
+    car.vz = dir * 3.4;
+    car.face = dir;
+    car.down = false;
+    car.bound = false;
+    this.live.forEach((p) => { p.passRank = 0; });
