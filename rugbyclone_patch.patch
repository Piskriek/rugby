+  e: 'dummy', q: 'switchPlayer',
+  r: 'replay', tab: 'stats', escape: 'pause',
+};
+
+export function MatchView({ cfg, onExit, onFinish, clinic, objective, tutorial }: {
+  cfg: MatchConfig; onExit: () => void;
