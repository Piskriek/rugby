+      last = now;
+
+      const inp: Input = { ...NO_INPUT };
+      for (const raw of keys.current) {
+        const m = KEYMAP[raw];
+        if (!m) continue;
+        switch (m) {
+          case 'left': inp.left = true; break;
+          case 'right': inp.right = true; break;
+          case 'up': inp.up = true; break;
+          case 'down': inp.down = true; break;
