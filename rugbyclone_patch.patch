+  { id: 'P-016', cat: 'PASSING', complaint: 'Receivers run backwards to collect the ball.', cause: 'Target solved behind the receiver.', fix: 'All pass targets are forward of the passer by a minimum of 0.4 m per metre of pass distance.', inGame: 'Pass target forwardness rule.', status: 'FIXED' },
+  { id: 'P-017', cat: 'PASSING', complaint: 'You cannot see who you are passing to.', cause: 'No receiver indication.', fix: 'The intended receiver is highlighted with a marker and his name before the press commits.', inGame: 'Pass-target indicator in the HUD and in-world.', status: 'FIXED' },
+  { id: 'P-018', cat: 'PASSING', complaint: 'The ball sails over the backline.', cause: 'Flat pass solved with too much vertical velocity.', fix: 'Flight is a solved arc with a fixed arrival height at chest level.', inGame: 'Pass arc solver.', status: 'FIXED' },
+  { id: 'P-019', cat: 'PASSING', complaint: 'Passes get batted down by nobody in particular.', cause: 'Random deflection roll not tied to any defender.', fix: 'A deflection requires a defender inside 1.2 m of the line of flight. Nothing happens without a body.', inGame: 'Line-of-flight deflection test.', status: 'FIXED' },
+  { id: 'P-020', cat: 'PASSING', complaint: 'You cannot run a loop or an angle.', cause: 'Only straight lateral offsets are available.', fix: 'Set plays include loops, switches, misses and crosses, each with named runner instructions.', inGame: 'Ten set plays callable at any ruck, scrum or lineout.', status: 'FIXED' },
+  { id: 'P-021', cat: 'PASSING', complaint: 'Passing out of your own twenty-two is suicide.', cause: 'Defenders arrive before the ball does.', fix: 'The nine distributes at full speed and the first receiver starts moving on release, so the ball beats the rush.', inGame: 'Distribution speed plus momentum carry-out.', status: 'FIXED' },
+  { id: 'P-022', cat: 'PASSING', complaint: 'Scrum halves take an age to move the ball.', cause: 'A fixed post-ruck delay before distribution.', fix: 'Distribution delay is a function of ruck quality only: 0.5 s for quick ball, 1.6 s for slow. Never longer.', inGame: 'Ruck-speed-driven distribution, hard capped.', status: 'FIXED' },
+  { id: 'P-023', cat: 'PASSING', complaint: 'The pass goes the opposite direction to the input.', cause: 'Direction resolved relative to camera rather than to the attacking line.', fix: 'Pass direction is resolved relative to the attacking direction and the carrier\'s shoulders, never to the camera.', inGame: 'Attack-relative pass mapping.', status: 'FIXED' },
+  { id: 'P-024', cat: 'PASSING', complaint: 'Pass accuracy does not seem to relate to the player.', cause: 'Accuracy is a global constant.', fix: 'Accuracy is per player, driven by the HANDLING attribute, the wet-ball state and the pressure on the passer.', inGame: 'Per-player handling model.', status: 'FIXED' },
+  { id: 'P-025', cat: 'PASSING', complaint: 'You cannot pass with any finesse — it is all or nothing.', cause: 'One pass type.', fix: 'Six pass behaviours: short, cut-out, spiral, dummy, pop and offload.', inGame: 'Pass behaviour table.', status: 'FIXED' },
+
+  /* ---------------- AI SHAPE ---------------- */
+  { id: 'A-001', cat: 'AI SHAPE', complaint: 'Players are never in their correct position.', cause: 'Positions are emergent from a generic steering behaviour with no positional authority.', fix: 'Fifteen role contracts, one per shirt, each specifying lateral offset and depth for every phase.', inGame: 'Role contract table, 15 shirts × 7 phases.', status: 'FIXED' },
+  { id: 'A-002', cat: 'AI SHAPE', complaint: 'Props line up at fly-half while full-backs are rucking.', cause: 'Role assignment by proximity rather than by shirt number.', fix: 'Role assignment is by shirt number. A prop can never occupy a back\'s slot.', inGame: 'Contract-for-shirt lookup, hard wired.', status: 'FIXED' },
+  { id: 'A-003', cat: 'AI SHAPE', complaint: 'Pointless having a backline because the forwards play fly-half.', cause: 'First receiver is whoever is nearest.', fix: 'The ten is first receiver on every phase unless a forward carry is explicitly called.', inGame: 'First-receiver contract on shirt 10.', status: 'FIXED' },
+  { id: 'A-004', cat: 'AI SHAPE', complaint: 'No player repositioning — nobody returns to their normal position.', cause: 'No reset behaviour between phases.', fix: 'Shape re-forms within two seconds of the ball being cleared, from the contract, every phase.', inGame: 'Shape reset on ball availability.', status: 'FIXED' },
+  { id: 'A-005', cat: 'AI SHAPE', complaint: 'Your right prop ends up on the wing facing a winger.', cause: 'Forwards follow the ball laterally without limit.', fix: 'Forwards are clamped to the channels their contract allows. A prop never exceeds the ten channel.', inGame: 'Lateral clamp per shirt.', status: 'FIXED' },
+  { id: 'A-006', cat: 'AI SHAPE', complaint: 'Three players float around the ruck instead of coming into it.', cause: 'No arrival order and no commitment signal.', fix: 'Three players are assigned to every breakdown by name, in arrival order, before the tackle is even made.', inGame: 'Pre-assigned breakdown crew.', status: 'FIXED' },
+  { id: 'A-007', cat: 'AI SHAPE', complaint: 'Support runners do not arrive.', cause: 'Support is a single vague follow behaviour.', fix: 'The openside flanker rides the carrier\'s hip and the eight trails at four metres on every carry.', inGame: 'Support contracts on shirts 7 and 8.', status: 'FIXED' },
+  { id: 'A-008', cat: 'AI SHAPE', complaint: 'Teammates simply run back into busy areas.', cause: 'Target is the ball, not space.', fix: 'Attackers target the gap between defenders, never the ball carrier\'s position.', inGame: 'Gap-seeking target selection.', status: 'FIXED' },
+  { id: 'A-009', cat: 'AI SHAPE', complaint: 'Huge gaps left in the defensive line cause easy line breaks.', cause: 'Defenders space themselves by fixed count, not by pitch width.', fix: 'The line distributes across the width actually available with a hard maximum spacing of four metres.', inGame: 'Connected-line solver.', status: 'FIXED' },
+  { id: 'A-010', cat: 'AI SHAPE', complaint: 'The AI is useless on defence — it parts like the Red Sea.', cause: 'Defenders react to the carrier only after a long reaction delay.', fix: 'Defenders react inside 0.15 s and hold their lane. The line never opens a hole wider than four metres by accident.', inGame: 'Reaction cap plus lane discipline.', status: 'FIXED' },
+  { id: 'A-011', cat: 'AI SHAPE', complaint: 'The CPU does one pass and goes into a tackle. Repeat. No intelligence at all.', cause: 'CPU attack has no plan, only a per-carrier decision.', fix: 'The CPU enters each phase with a called play and a target channel, and commits to it across three phases.', inGame: 'CPU play-calling with phase continuity.', status: 'FIXED' },
+  { id: 'A-012', cat: 'AI SHAPE', complaint: 'I put my controller down and the CPU did nothing but that.', cause: 'CPU attack has no fallback when the primary play is closed.', fix: 'If the called play is closed, the CPU escalates: pod carry, then wide sweep, then kick. It never repeats a failed play.', inGame: 'Play escalation ladder.', status: 'FIXED' },
+  { id: 'A-013', cat: 'AI SHAPE', complaint: 'The CPU runs out into touch with the ball.', cause: 'No touchline awareness in the steering target.', fix: 'A steering target is never placed within 2.5 m of touch, and the CPU carrier steps infield inside 5 m of touch.', inGame: 'Touchline avoidance.', status: 'FIXED' },
+  { id: 'A-014', cat: 'AI SHAPE', complaint: 'Players react with a big delay in defence.', cause: 'A single global reaction timer.', fix: 'Reaction is per player, driven by AWARENESS, capped at 0.2 s, and is never scaled up to create difficulty.', inGame: 'Per-player awareness reaction.', status: 'FIXED' },
+  { id: 'A-015', cat: 'AI SHAPE', complaint: 'The full-back joins the line and leaves nobody at home.', cause: 'No sweeper contract.', fix: 'The fifteen sweeps on every phase and only ever joins the line when the overlap count is two or more.', inGame: 'Sweeper contract on shirt 15.', status: 'FIXED' },
+  { id: 'A-016', cat: 'AI SHAPE', complaint: 'Wings come in and ruck.', cause: 'No prohibition on backs entering breakdowns.', fix: 'Shirts 11, 13, 14 and 15 are contractually forbidden from entering a ruck.', inGame: 'Ruck ineligibility list.', status: 'FIXED' },
+  { id: 'A-017', cat: 'AI SHAPE', complaint: 'The scrum half gets trapped in the ruck and a forward has to fetch the ball from thirty metres away.', cause: 'Receiver selection by nearest-anyone with no eligibility order.', fix: 'Eligibility order for playing the ball at a ruck: nine, then eight, then two. Never a back from distance.', inGame: 'Ruck distribution eligibility order.', status: 'FIXED' },
+  { id: 'A-018', cat: 'AI SHAPE', complaint: 'Forwards stand in the backline doing nothing.', cause: 'Forwards have no job between carries.', fix: 'Between carries forwards hold a pod behind the ruck, ready to take the next ball, and are the first to the following breakdown.', inGame: 'Pod contract for shirts 1 to 8.', status: 'FIXED' },
+  { id: 'A-019', cat: 'AI SHAPE', complaint: 'Defensive line speed is inconsistent, sometimes rush, sometimes passive.', cause: 'Line speed derived from difficulty level rather than from the system and the situation.', fix: 'Line speed is a property of the defensive system and the slider, and is constant within a match.', inGame: 'System-driven line speed.', status: 'FIXED' },
+  { id: 'A-020', cat: 'AI SHAPE', complaint: 'Defenders shoot up out of the line and leave the outside uncovered.', cause: 'Individual defenders choose to rush without a system-level agreement.', fix: 'Rush, drift and umbrella are system-wide. Either the whole line rushes or none of it does.', inGame: 'System-level defensive assignments.', status: 'FIXED' },
+  { id: 'A-021', cat: 'AI SHAPE', complaint: 'Nobody chases kicks.', cause: 'Chase assignment is implicit.', fix: 'Three chasers with named lanes are assigned the moment the kick is struck.', inGame: 'Kick-chase lane assignment.', status: 'FIXED' },
+  { id: 'A-022', cat: 'AI SHAPE', complaint: 'Nobody fields the high ball.', cause: 'No receiver call.', fix: 'The fifteen calls for the ball and has priority. Wings contest only when he is out of position.', inGame: 'Kick-receive priority order.', status: 'FIXED' },
+  { id: 'A-023', cat: 'AI SHAPE', complaint: 'The AI kicks aimlessly.', cause: 'Kick decision is a random roll.', fix: 'CPU kicks are chosen from a table of eight kick types, selected by field position, chase quality and wind.', inGame: 'Situational kick selection.', status: 'FIXED' },
+  { id: 'A-024', cat: 'AI SHAPE', complaint: 'The AI does not manage the clock at the end of a match.', cause: 'No clock state in the decision model.', fix: 'A leading CPU kicks to touch and slows the ball after the seventieth minute. A trailing CPU raises tempo and risks.', inGame: 'Clock-aware decision weighting.', status: 'FIXED' },
+  { id: 'A-025', cat: 'AI SHAPE', complaint: 'The AI never takes a drop goal when it should.', cause: 'Drop goal is not in the option table for the CPU.', fix: 'Drop goal is a weighted CPU option inside the 40 m zone with the clock against them.', inGame: 'CPU drop-goal option.', status: 'FIXED' },
+  { id: 'A-026', cat: 'AI SHAPE', complaint: 'Winning scrums and lineouts is far too easy.', cause: 'Set-piece outcome weighted to the human.', fix: 'Set-piece outcome is a pure rating contest with a small skill input, and the input is legible.', inGame: 'Rating-led set-piece model.', status: 'FIXED' },
+  { id: 'A-027', cat: 'AI SHAPE', complaint: 'Sidestepping destroys every tackle attempt.', cause: 'Evade chance is high and independent of the defender\'s positioning.', fix: 'A step only beats a defender who is square-on and inside 2.5 m. A lateral defender cannot be stepped.', inGame: 'Step validity test.', status: 'FIXED' },
+  { id: 'A-028', cat: 'AI SHAPE', complaint: 'The computer gives away penalties too easily.', cause: 'Penalty roll is constant and high.', fix: 'Discipline is an attribute. A disciplined side concedes half the penalties of an undisciplined one, and never in bulk.', inGame: 'Discipline attribute in the penalty model.', status: 'FIXED' },
+  { id: 'A-029', cat: 'AI SHAPE', complaint: 'There is no difference between teams — everyone plays the same.', cause: 'One shared AI profile.', fix: 'Five CPU archetypes with different kick, width, offload and set-piece biases, plus per-team ratings.', inGame: 'Archetype and ratings model.', status: 'FIXED' },
+  { id: 'A-030', cat: 'AI SHAPE', complaint: 'Higher difficulty just makes the AI cheat.', cause: 'Difficulty applied as a stat multiplier.', fix: 'Difficulty scales decision quality only — reaction, error and read rates. Never speed, never strength.', inGame: 'Ten rungs scaling decisions, not physics.', status: 'FIXED' },
+  { id: 'A-031', cat: 'AI SHAPE', complaint: 'Players bump into each other and get stuck.', cause: 'No local separation behaviour.', fix: 'Teammates apply separation and never block their own carrier. Friendly collision is disabled inside 2 m of the ball.', inGame: 'Separation and no-friendly-block.', status: 'FIXED' },
+  { id: 'A-032', cat: 'AI SHAPE', complaint: 'You get blocked by your own players at the base of the ruck.', cause: 'Ruck participants stand up in the carrier\'s path.', fix: 'Clearers finish past the ball and exit laterally, never standing up in the gate.', inGame: 'Clearer exit path.', status: 'FIXED' },
+  { id: 'A-033', cat: 'AI SHAPE', complaint: 'Substitutions are made by the AI at random times.', cause: 'No fatigue logic.', fix: 'Bench use is driven by live per-player fatigue and always replaces the most tired forward first.', inGame: 'Fatigue-driven bench logic.', status: 'FIXED' },
+
+  /* ---------------- RUCKS ---------------- */
+  { id: 'R-001', cat: 'RUCKS', complaint: 'Rucks are a total button-mash mess.', cause: 'Resolution is a raw alternating-press counter with no legible state.', fix: 'The ruck shows a live force bar, the number committed on each side, and who is winning. The mash is optional and off by default.', inGame: 'Legible ruck contest; manual waggle is an option.', status: 'FIXED' },
+  { id: 'R-002', cat: 'RUCKS', complaint: 'It is extremely hard to steal the ball, so defence is just mashing.', cause: 'Jackal chance is a low constant regardless of numbers.', fix: 'Jackal chance scales with the difference in committed players, the arriving player\'s AWARENESS, and ball speed.', inGame: 'Numbers-and-quality jackal model.', status: 'FIXED' },
+  { id: 'R-003', cat: 'RUCKS', complaint: 'When I do win a contest I cannot tell why.', cause: 'No feedback on resolution.', fix: 'Every ruck resolution prints one line stating the margin and the reason.', inGame: 'Ruck resolution caption.', status: 'FIXED' },
+  { id: 'R-004', cat: 'RUCKS', complaint: 'Turnovers are constant and unavoidable.', cause: 'Independent turnover rolls with no player agency.', fix: 'Turnover only occurs when the defence legally wins it: numbers advantage or a clean jackal. Never at random.', inGame: 'Legal-turnover-only rule.', status: 'FIXED' },
+  { id: 'R-005', cat: 'RUCKS', complaint: 'A random player picks and grubbers the ball when I did not ask for that.', cause: 'Action queue combined with a context misread.', fix: 'No action is queued. Playing the ball at the ruck is an explicit choice between pick-and-go and pass.', inGame: 'Explicit ball-play choice; nothing queued.', status: 'FIXED' },
+  { id: 'R-006', cat: 'RUCKS', complaint: 'The game waits for an arbitrary player to walk to the back of the ruck.', cause: 'Receiver selection by nearest-anyone with no fast path.', fix: 'Distribution is instant from whoever is eligible and present, in the order nine, eight, two.', inGame: 'Eligibility order with instant distribution.', status: 'FIXED' },
+  { id: 'R-007', cat: 'RUCKS', complaint: 'There is no dead ball for ages at a time.', cause: 'Ruck timers stack with stoppages.', fix: 'Dead ball is capped at four seconds and restart choreography overlaps with the score card.', inGame: 'Dead-ball cap.', status: 'FIXED' },
+  { id: 'R-008', cat: 'RUCKS', complaint: 'You cannot see the ball in the ruck.', cause: 'Ball hidden under bodies.', fix: 'The ball marker is drawn on top of the ruck at its true position at all times.', inGame: 'Always-visible ball marker.', status: 'FIXED' },
+  { id: 'R-009', cat: 'RUCKS', complaint: 'Rucks form wherever, with players standing around them.', cause: 'No ruck structure definition.', fix: 'A ruck has a defined gate, an offside line per side, and a maximum of six participants.', inGame: 'Ruck geometry model.', status: 'FIXED' },
+  { id: 'R-010', cat: 'RUCKS', complaint: 'Slow ball every time, no matter what I do.', cause: 'Ruck speed independent of clearout quality.', fix: 'Ruck speed is a direct function of clearout quality and numbers. Good play is rewarded visibly.', inGame: 'Clearout-quality ruck speed.', status: 'FIXED' },
+  { id: 'R-011', cat: 'RUCKS', complaint: 'Counter-rucking does nothing.', cause: 'No counter-ruck mechanic.', fix: 'Counter-rucking is a deliberate choice: commit two or more early to blow through the gate and win the penalty.', inGame: 'Counter-ruck commit option.', status: 'FIXED' },
+  { id: 'R-012', cat: 'RUCKS', complaint: 'The offside line at the ruck is invisible.', cause: 'Not drawn.', fix: 'Both offside lines are drawn in world space the moment the ruck forms, in team colours.', inGame: 'World-space offside lines.', status: 'FIXED' },
+  { id: 'R-013', cat: 'RUCKS', complaint: 'Offside penalties against me when I am attacking.', cause: 'Offside tested on all players including those behind the play in their own half.', fix: 'Offside is only tested on players ahead of the ball and inside the relevant half. Attackers behind the play are exempt.', inGame: 'Directional offside test.', status: 'FIXED' },
+  { id: 'R-014', cat: 'RUCKS', complaint: 'My player is automatically placed offside when I take possession.', cause: 'Possession snaps the player to a spot past the offside line.', fix: 'Possession never moves a player. He plays the ball from where he legally stands.', inGame: 'No-snap possession.', status: 'FIXED' },
+  { id: 'R-015', cat: 'RUCKS', complaint: 'Hands in the ruck is called constantly.', cause: 'Any player near the ball can trigger it.', fix: 'Only a player arriving ahead of the ball from an offside position can be penalised for hands.', inGame: 'Arrival-position legality test.', status: 'FIXED' },
+  { id: 'R-016', cat: 'RUCKS', complaint: 'The ruck clock feels arbitrary.', cause: 'A fixed global timer.', fix: 'Ruck clock is a setting — 1.5, 3.0 or 5.0 seconds — and the countdown is drawn on the pitch.', inGame: 'Configurable, visible ruck clock.', status: 'FIXED' },
+  { id: 'R-017', cat: 'RUCKS', complaint: 'Mauls are pretty awful and unreadable.', cause: 'Maul force is invisible.', fix: 'Both forces are drawn as kN bars with a live metres-per-second readout and a stall clock.', inGame: 'Maul telemetry.', status: 'FIXED' },
+  { id: 'R-018', cat: 'RUCKS', complaint: 'You cannot transfer the ball to the back of the maul.', cause: 'No ball-rank mechanic.', fix: 'The ball rank is shown and can be moved to the tail deliberately to protect it.', inGame: 'Maul ball-rank control.', status: 'FIXED' },
+  { id: 'R-019', cat: 'RUCKS', complaint: 'The maul gets turned over with no warning.', cause: 'Stall rule not surfaced.', fix: 'The stall clock is drawn on the pitch with the law threshold, and the referee warns once before whistling.', inGame: 'Maul stall clock with warning.', status: 'FIXED' },
+  { id: 'R-020', cat: 'RUCKS', complaint: 'Rucks take too long overall.', cause: 'Resolution timer plus animation plus distribution delay.', fix: 'Quick ball is available in 0.5 seconds and the whole breakdown resolves inside 2.5 seconds.', inGame: 'Hard caps on breakdown duration.', status: 'FIXED' },
+
+  /* ---------------- SCRUMS ---------------- */
+  { id: 'S-001', cat: 'SCRUMS', complaint: 'Scrums — what am I supposed to do?', cause: 'No instruction at the point of play.', fix: 'The command is printed on the pitch in plain language at every stage, synchronised to the referee cadence.', inGame: 'On-screen scrum commands.', status: 'FIXED' },
+  { id: 'S-002', cat: 'SCRUMS', complaint: 'The timing gauge is not synced with the referee\'s instructions.', cause: 'Meter timer independent of the cadence sequence.', fix: 'The meter is driven by the cadence itself. There is no independent timer to fall out of sync.', inGame: 'Cadence-driven scrum meter.', status: 'FIXED' },
+  { id: 'S-003', cat: 'SCRUMS', complaint: 'The bar is impossible to see.', cause: 'Small, low-contrast, in a corner.', fix: 'The bar is drawn on the pitch at the scrum, is wide, colour-banded and duplicated as text.', inGame: 'In-world scrum meter.', status: 'FIXED' },
+  { id: 'S-004', cat: 'SCRUMS', complaint: 'Scrums look like a bunch of players fondling each other.', cause: 'Bind geometry is wrong — packs face the wrong way or stand apart.', fix: 'The tunnel runs across the pitch, packs bind face to face, and eight men per side occupy the correct rows.', inGame: 'Correct scrum geometry and binding.', status: 'FIXED' },
+  { id: 'S-005', cat: 'SCRUMS', complaint: 'You lose every scrum no matter what you do.', cause: 'Outcome weighted to the CPU or to a hidden stat.', fix: 'Outcome is a legible rating contest plus your input. A dominant pack wins, a weak one loses, and the meter tells you which you are.', inGame: 'Legible scrum contest.', status: 'FIXED' },
+  { id: 'S-006', cat: 'SCRUMS', complaint: 'The waggle wrecks your controller and your wrist.', cause: 'Manual waggling is mandatory.', fix: 'Manual waggle is an option, off by default. Auto-push is available and only slightly worse than a good manual effort.', inGame: 'Scrum waggle toggle.', status: 'FIXED' },
+  { id: 'S-007', cat: 'SCRUMS', complaint: 'Scrums take too long and kill the pace.', cause: 'Full cadence plus a long drive phase every time.', fix: 'The cadence can be shortened and the drive phase is capped at 2.1 seconds.', inGame: 'Cadence length option, drive cap.', status: 'FIXED' },
+  { id: 'S-008', cat: 'SCRUMS', complaint: 'The scrum collapses for no reason.', cause: 'Random collapse roll.', fix: 'Collapse risk is a function of the force differential and both packs\' stability. It is displayed before it happens.', inGame: 'Visible collapse risk model.', status: 'FIXED' },
+  { id: 'S-009', cat: 'SCRUMS', complaint: 'You cannot choose to wheel or strike.', cause: 'One generic shove.', fix: 'Four scrum agendas: eight-man shove, wheel for it, strike-heavy, five-three split.', inGame: 'Scrum agenda selection.', status: 'FIXED' },
+  { id: 'S-010', cat: 'SCRUMS', complaint: 'The number eight never breaks off the base.', cause: 'No pick-up from the scrum base.', fix: 'The eight can control at the base and either go himself or feed the nine.', inGame: 'Eight-nine off the scrum set play.', status: 'FIXED' },
+  { id: 'S-011', cat: 'SCRUMS', complaint: 'Penalties at the scrum are random.', cause: 'No attribution.', fix: 'Every scrum penalty names the offence and the offending shirt number.', inGame: 'Attributed scrum penalties.', status: 'FIXED' },
+  { id: 'S-012', cat: 'SCRUMS', complaint: 'Reset scrums loop forever.', cause: 'No reset cap.', fix: 'Two resets maximum, then a free kick to whichever side did not cause them.', inGame: 'Reset cap.', status: 'FIXED' },
+
+  /* ---------------- LINEOUTS ---------------- */
+  { id: 'L-001', cat: 'LINEOUTS', complaint: 'You cannot compete at the lineout.', cause: 'Outcome is a coin flip with no input.', fix: 'You call the throw, time the release against a legible band, and the lifter and jumper both animate.', inGame: 'Player-contested lineout.', status: 'FIXED' },
+  { id: 'L-002', cat: 'LINEOUTS', complaint: 'The throw is a lottery.', cause: 'Meter timing is arbitrary and unshown.', fix: 'The band is wide, drawn on the pitch, and the sweet spot is marked. The result is a direct function of where you stop.', inGame: 'Legible throw meter.', status: 'FIXED' },
+  { id: 'L-003', cat: 'LINEOUTS', complaint: 'Janky lift animations ruin the immersion.', cause: 'Lifter and jumper animations are independent.', fix: 'Lifter drive and jumper extension are keyed to the same timeline so the lift reads as one movement.', inGame: 'Synchronised lift timeline.', status: 'FIXED' },
+  { id: 'L-004', cat: 'LINEOUTS', complaint: 'The lineout forms in the wrong place.', cause: 'Mark placed at the ball rather than where it crossed touch.', fix: 'The mark is where the ball crossed touch, between five and fifteen metres in, and the line forms a metre apart.', inGame: 'Correct lineout placement.', status: 'FIXED' },
+  { id: 'L-005', cat: 'LINEOUTS', complaint: 'Not straight is called randomly.', cause: 'Independent roll.', fix: 'Not straight is a direct function of how far your throw deviated from the call.', inGame: 'Deviation-driven throw legality.', status: 'FIXED' },
+  { id: 'L-006', cat: 'LINEOUTS', complaint: 'You cannot choose a front, middle or tail ball.', cause: 'One throw type.', fix: 'Four calls: front, middle and drive, off the top, tail. Plus a miss-and-peel option.', inGame: 'Lineout call table.', status: 'FIXED' },
+  { id: 'L-007', cat: 'LINEOUTS', complaint: 'The lineout drive is impossible to stop.', cause: 'Maul force unbalanced.', fix: 'Defence can sack the jumper on landing or commit to the drive, both with visible force bars.', inGame: 'Lineout drive counter.', status: 'FIXED' },
+  { id: 'L-008', cat: 'LINEOUTS', complaint: 'The hooker throws from the wrong place.', cause: 'Thrower positioned on the pitch rather than outside the line.', fix: 'The thrower stands two metres outside the line of touch.', inGame: 'Correct thrower placement.', status: 'FIXED' },
+  { id: 'L-009', cat: 'LINEOUTS', complaint: 'Peeling is not in the game.', cause: 'No peel mechanic.', fix: 'Miss-and-peel is a callable option that sets the maul moving before contact.', inGame: 'Miss-and-peel call.', status: 'FIXED' },
+  { id: 'L-010', cat: 'LINEOUTS', complaint: 'A softlock at a lineout forces a restart.', cause: 'State machine can stall waiting on an arrival.', fix: 'Assembly state has a hard two-second cap. The set piece begins whether or not everyone has arrived.', inGame: 'Assembly cap; no stall is possible.', status: 'FIXED' },
+
+  /* ---------------- KICKING ---------------- */
+  { id: 'K-001', cat: 'KICKING', complaint: 'All aspects of kicking are shocking.', cause: 'One kick verb with an opaque power meter.', fix: 'Five kick verbs, each with an aim line, a landing ellipse, a readable power bar and a stated success probability.', inGame: 'Five-verb kick model with full telemetry.', status: 'FIXED' },
+  { id: 'K-002', cat: 'KICKING', complaint: 'A slight joystick wobble completely depletes the power.', cause: 'Power read continuously from the stick.', fix: 'Power is set by two discrete presses and is never affected by subsequent movement. Aim is locked once set.', inGame: 'Discrete kick meter.', status: 'FIXED' },
+  { id: 'K-003', cat: 'KICKING', complaint: 'Goal kicking is ridiculously difficult.', cause: 'Twitch timing plus unshown angle and distance.', fix: 'Distance, angle and live probability are all displayed before you commit, and accuracy is gated by the kicker rating.', inGame: 'Goal kick telemetry.', status: 'FIXED' },
+  { id: 'K-004', cat: 'KICKING', complaint: 'The kicker changes at random.', cause: 'Kicker selected by proximity.', fix: 'The designated goal kicker, chosen on the squad sheet, takes every goal kick.', inGame: 'Designated kicker.', status: 'FIXED' },
+  { id: 'K-005', cat: 'KICKING', complaint: 'You cannot see the ten behind the play to kick with him.', cause: 'Camera frames the ball only.', fix: 'Camera framing includes the ball plus the first three attackers, so the ten is always on screen.', inGame: 'Framing target includes the first receiver.', status: 'FIXED' },
+  { id: 'K-006', cat: 'KICKING', complaint: 'When you are close to touch it makes you kick to the other side.', cause: 'Kick direction snapped to a fixed cone.', fix: 'Aim is continuous and shown as a line plus a landing ellipse you steer.', inGame: 'Continuous kick aim.', status: 'FIXED' },
+  { id: 'K-007', cat: 'KICKING', complaint: 'The grubber has no control.', cause: 'One rolling kick with fixed velocity.', fix: 'Tap for a short rolling kick, hold for a low driving kick. Length and roll are both yours.', inGame: 'Two-mode grubber.', status: 'FIXED' },
+  { id: 'K-008', cat: 'KICKING', complaint: 'The bomb is always regathered by the AI.', cause: 'Contest resolution ignores the chasers.', fix: 'Regather is a contest between your assigned chasers and their receiver, weighted by the chase slider.', inGame: 'Chase-weighted bomb contest.', status: 'FIXED' },
