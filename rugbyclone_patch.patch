@@ -0,0 +1,64 @@
+/**
+ * Classify how every OPEN_PLAY episode ends across N seconds of CPU-v-CPU —
+ * the diagnostic behind "TACKLES HAPPEN" failing.
+ * Usage: npx vite-node scripts/probe_open.ts [difficulty] [seconds]
+ */
+import { Director, NO_INPUT } from '../src/game/director';
+import { gateConfig } from '../src/game/gates';
+
+const diff = Number(process.argv[2] ?? 6);
+const seconds = Number(process.argv[3] ?? 120);
+
+const d = new Director(gateConfig(diff));
+const dt = 1 / 60;
+const ends: Record<string, number> = {};
+const phaseTime: Record<string, number> = {};
+let episodes = 0;
+const minD: number[] = [];
+
+for (let i = 0; i < seconds * 60; i++) {
+  const phaseBefore = d.phase;
+  const carrierBefore = d.op?.carrierNum;
+  const wasOpen = phaseBefore === 'OPEN_PLAY' && d.op && !d.op.ball.live;
+  let nearest = 99;
+  if (wasOpen) {
+    const car = d.live.find((p) => p.team === d.op!.attacking && p.num === d.op!.carrierNum);
+    if (car) {
+      for (const p of d.live) {
+        if (p.team !== car.team && p.sinbin <= 0) {
+          nearest = Math.min(nearest, Math.hypot(p.x - car.x, p.z - car.z));
+        }
+      }
+      minD.push(nearest);
+    }
+  }
+  d.update(dt, NO_INPUT, new Set());
+  phaseTime[phaseBefore] = (phaseTime[phaseBefore] ?? 0) + dt;
+
+  if (wasOpen && (d.phase !== 'OPEN_PLAY' || !d.op || d.op.carrierNum !== carrierBefore || d.op.ball.live)) {
+    episodes++;
+    let why: string;
+    if (d.phase === 'OPEN_PLAY' && d.op?.ball.live) why = 'pass';
+    else if (d.phase === 'BREAKDOWN') why = d.feed[0]?.text?.includes('TACKLE') ? 'tackle' : 'breakdown';
+    else if (d.phase === 'KICK') why = 'kick';
+    else if (d.phase === 'LINEOUT') why = 'touch';
+    else if (d.phase === 'SCRUM') why = 'scrum(5m/knockon)';
+    else if (d.phase === 'OPEN_PLAY' && d.op && d.op.carrierNum !== carrierBefore) why = 'offload/new carrier';
+    else why = d.phase;
+    ends[why] = (ends[why] ?? 0) + 1;
+  }
+}
+
+console.log(`\nCPU-v-CPU difficulty ${diff}, ${seconds}s`);
+console.log('phase seconds:', Object.entries(phaseTime).map(([k, v]) => `${k}:${v.toFixed(0)}s`).join('  '));
+console.log(`open-play episodes: ${episodes}`);
+console.log('episode endings:', Object.entries(ends).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k}:${v}`).join('  '));
+if (minD.length) {
+  const close = minD.filter((m) => m < 1.1).length;
+  const near = minD.filter((m) => m < 3).length;
+  const sorted = [...minD].sort((a, b) => a - b);
+  console.log(`carrier frames: ${minD.length}, min-defender<1.1m: ${close} (${(100 * close / minD.length).toFixed(1)}%), <3m: ${near} (${(100 * near / minD.length).toFixed(1)}%)`);
+  console.log(`closest approach ever: ${sorted[0]?.toFixed(2)}m, p5: ${sorted[Math.floor(sorted.length * 0.05)]?.toFixed(2)}m, median: ${sorted[Math.floor(sorted.length / 2)]?.toFixed(2)}m`);
+}
+console.log(`tackles A/B: ${d.A.stats.tackles}/${d.B.stats.tackles}  rucks A/B: ${d.A.stats.rucks}/${d.B.stats.rucks}  kicks A/B: ${d.A.stats.kicks}/${d.B.stats.kicks}  passes A/B: ${d.A.stats.passes}/${d.B.stats.passes}`);
+console.log(`score ${d.A.score}-${d.B.score}, phases seen:`, Object.keys(phaseTime).join(' '));
