+      <div className={`text-xl font-black tabular-nums ${bad ? 'text-[#ff6a5a]' : 'text-[#6ee7a0]'}`}>{value}</div>
+    </div>
+  );
+}
+
+function Row({ k, v }: { k: string; v: string }) {
