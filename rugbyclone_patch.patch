@@ -0,0 +1,21 @@
+// Temporary probe: wrap phase handlers to capture the throw's stack.
+import { Director, NO_INPUT } from '../src/game/director';
+import { gateConfig } from '../src/game/gates';
+
+const names = ['upOpen', 'upBreakdown', 'upScrum', 'upLineout', 'upMaul', 'upKick'] as const;
+for (let run = 0; run < 10; run++) {
+  const d: any = new Director(gateConfig([3, 6, 9][run % 3]));
+  const stacks: string[] = [];
+  for (const n of names) {
+    const orig = d[n].bind(d);
+    d[n] = (...a: any[]) => {
+      try { return orig(...a); } catch (e) {
+        stacks.push(`${n}: ${e instanceof Error ? e.stack : e}`);
+        throw e;
+      }
+    };
+  }
+  let guard = 0;
+  while (!d.over && guard < 60 * 240) { d.update(1 / 60, NO_INPUT, new Set()); guard++; }
+  if (stacks.length) { console.log(stacks[0]); break; }
+}
