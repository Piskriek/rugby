+/**
+ * Diagnose a single runDeep pass: print fault kinds, first examples of each,
+ * and (in dev) the T-02 double-move warnings from the engine.
+ *
+ * Usage: npx vite-node scripts/diag.ts [difficulty] [seconds]
+ */
+import { runDeep } from '../src/game/trace';
+import { gateConfig } from '../src/game/gates';
+
+const diff = Number(process.argv[2] ?? 6);
+const seconds = Number(process.argv[3] ?? 60);
+
+const r = runDeep(gateConfig(diff), seconds);
+
+const kinds = new Map<string, number>();
+for (const d of r.diags) kinds.set(d.kind, (kinds.get(d.kind) ?? 0) + 1);
+console.log(`\ndifficulty ${diff}, ${seconds}s — ${r.totalFrames} frames`);
+console.log('fault kinds:', Array.from(kinds.entries()).map(([k, n]) => `${k}:${n}`).join('  '));
+console.log('phases visited:', r.phasesVisited.join(' '), `(${r.phaseChanges} changes)`);
+console.log('summary:');
+for (const s of r.summary) console.log(`  ${s}`);
+
+const shown = new Set<string>();
+for (const d of r.diags) {
+  if (shown.has(d.kind)) continue;
+  shown.add(d.kind);
+  console.log(`\nfirst ${d.kind} @ t=${d.t}s [${d.severity}] ${d.detail}`);
+}
+// second and third teleport examples too — pattern across shirts matters
+const tel = r.diags.filter((d) => d.kind === 'TELEPORT').slice(0, 14);
+if (tel.length) {
+  console.log('\nteleport sample:');
+  for (const d of tel) console.log(`  t=${d.t}  ${d.detail}`);
+}
