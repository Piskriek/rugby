+  place(p: Live, x: number, z: number, who: string) {
+    if (import.meta.env.DEV && p.movedBy && p.movedBy !== who) {
+      console.warn(`[T-02] shirt ${p.num} (${p.team}) moved by ${p.movedBy}, then ${who} in one frame (phase ${this.phase})`);
+    }
+    p.movedBy = who;
+    p.x = x;
+    p.z = z;
+  }
