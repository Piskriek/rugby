+          p.face = slot.team === 'A' ? 1 : -1;
+        }
+        if (set) {
+          if (s.stage === 'DRIVE' || s.stage === 'BASE' || s.stage === 'STRIKE') clip(p, 'scrumDrive');
+          else if (s.stage === 'ENGAGE') clip(p, 'scrumCrouch');
