+    if (s.stage === 'RECYCLE') {
+      const outAt = s.groundAt + s.window + 0.15;
+      if (s.t >= outAt) {
+        const slow = s.window > 2.0;
+        this.teams[atk].stats.rucks++;
+        if (slow) this.teams[atk].stats.slowBall++;
